# Shell scripts must be LF: CRLF makes bash on Linux/macOS fail to even recognize the shebang
# (it reports "bad interpreter: /usr/bin/env bash^M").
*.sh text eol=lf

# PowerShell scripts are the opposite, kept as CRLF. These two also must be saved as UTF-8 with BOM,
# otherwise Windows PowerShell 5.1 decodes them as system ANSI, which garbles non-ASCII text into a parse error.
*.ps1 text eol=crlf

# Arduino sketches are opened with the Arduino IDE, kept in Windows convention.
*.ino text eol=crlf
