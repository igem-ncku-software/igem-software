// Copy this file to secrets.h (same folder) and fill in your Wi-Fi credentials.
// secrets.h is already in .gitignore and won't be committed; don't put real passwords in this template.
// ESP32 only supports 2.4 GHz Wi-Fi.
#pragma once
#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-password"

