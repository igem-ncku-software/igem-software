// 複製這個檔案為 secrets.h（同一個資料夾），填入 Wi-Fi 認證。
// secrets.h 已列在 .gitignore，不會被提交；這個範本不要填真的密碼。
// ESP32 只支援 2.4 GHz 的 Wi-Fi。
#pragma once
#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-password"

// 預設連 Render 上的正式後端，不需要改。
// 要接本機後端（在 backend/ 執行 uvicorn app.main:app --host 0.0.0.0 --port 8000）時，
// 取消下面三行的註解，填這台電腦在同一個 Wi-Fi 裡的 IP：
// #define BACKEND_HOST    "192.168.1.23"
// #define BACKEND_PORT    8000
// #define BACKEND_USE_TLS 0
