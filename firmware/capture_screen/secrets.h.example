// 把這個檔案複製成同資料夾的 secrets.h,再填入 Wi-Fi 帳密。
// secrets.h 已列在 .gitignore,不會被上傳;真正的密碼不要寫在這個範本裡。
// ESP32 只支援 2.4 GHz Wi-Fi。
#pragma once
#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-password"

// 預設連 Render 上的正式後端,不用改。
// 要連本機後端(在 backend/ 執行 `uvicorn app.main:app --host 0.0.0.0 --port 8000`),
// 取消下面三行的註解,填入這台電腦在同一個 Wi-Fi 下的 IP:
// #define BACKEND_HOST    "192.168.1.23"
// #define BACKEND_PORT    8000
// #define BACKEND_USE_TLS 0
