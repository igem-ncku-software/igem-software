// Copy this file to secrets.h in the same folder, then fill in your Wi-Fi credentials.
// secrets.h is listed in .gitignore and won't be uploaded; don't put real credentials in this template.
// The ESP32 only supports 2.4 GHz Wi-Fi.
#pragma once
#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-password"

