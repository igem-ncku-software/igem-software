# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ===== Virtual environment =====
.venv/
venv/
env/
ENV/

# ===== Tests / coverage =====
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ===== Environment variables / secrets =====
# Note: only ignore .env itself, not a .env* wildcard —
# that would also ignore backend/.env.example (the template, which should be tracked).
.env
.env.local
*.key
*.pem
secrets.json
# Firmware Wi-Fi credentials; template is firmware/as7341/secrets.h.example
secrets.h

# ===== IDE / editor =====
.vscode/
.idea/
*.swp
*.swo
*~
# Claude Code's local preview config (just starts a dev static server, not part of the project)
.claude/launch.json

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ===== Uploaded / temp user files (in case images etc. get stored later) =====
uploads/
*.tmp

# ===== Logs =====
*.log

# ===== Jupyter (in case notebooks get used for data analysis later) =====
.ipynb_checkpoints/

# ===== Frontend (in case an npm toolchain gets added later) =====
node_modules/
