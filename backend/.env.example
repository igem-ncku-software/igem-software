# 允許呼叫後端 API 的前端來源，用逗號分隔，不要有空白
CORS_ORIGINS=https://igem-ncku-software.github.io,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# CAPTURE-Screen 自己連進 WS /api/hardware/device，後端不會主動連裝置。
# 多久沒收到裝置的訊息就視為離線（韌體每 5 秒回報一次狀態）
HARDWARE_ONLINE_TIMEOUT_SECONDS=15
# 等一次量測結果的上限（量測本身約 3 秒）
HARDWARE_READ_TIMEOUT_SECONDS=10
