# Frontend origins allowed to call the backend API, comma-separated, no spaces
CORS_ORIGINS=https://igem-ncku-software.github.io,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# CAPTURE-Screen dials into WS /api/hardware/device itself; the backend never connects to the device.
# How long without a message from the device before it's considered offline (firmware reports every 5 s)
HARDWARE_ONLINE_TIMEOUT_SECONDS=15
# Upper bound on waiting for one measurement result (a measurement itself takes about 3 s)
HARDWARE_READ_TIMEOUT_SECONDS=10
