# 允許呼叫後端 API 的前端來源，用逗號分隔，不要有空白
CORS_ORIGINS=https://igem-ncku-software.github.io,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# CAPTURE-Screen 即時資料：mock 可在沒有硬體時使用；device 需讓後端和 ESP32 在同一個區網
HARDWARE_MODE=mock
HARDWARE_DEVICE_BASE_URL=http://capture-screen.local
HARDWARE_LIVE_INTERVAL_MS=250
HARDWARE_HTTP_TIMEOUT_SECONDS=8
